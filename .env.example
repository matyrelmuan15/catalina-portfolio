APP_NAME="Catalina Avendaño"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://catalina-portfolio.test

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_AR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=catalina_portfolio
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Valores de Railway (staging y producción). En local no se instala Redis:
# copiá este archivo a .env y cambiá estas dos líneas a sync/file.
QUEUE_CONNECTION=redis
CACHE_STORE=redis
CACHE_PREFIX=

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="catalinaavendanio@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"

# Cloudflare R2: token compartido entre los dos buckets (público y privado)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_DEFAULT_REGION=auto
R2_BUCKET_PUBLICO=catalina-publico
R2_URL_PUBLICO=
R2_BUCKET_PRIVADO=catalina-privado

# Cloudflare Turnstile — claves de prueba oficiales (superan siempre la verificación)
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Cloudflare: purga de caché de la portada al publicar o despublicar un video.
# Sin estas dos variables, la purga se omite (se registra en el log) en vez de fallar.
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=

TRUSTED_PROXIES=*

VITE_APP_NAME="${APP_NAME}"
VITE_TURNSTILE_SITE_KEY="${TURNSTILE_SITE_KEY}"
